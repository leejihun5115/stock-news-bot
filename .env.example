# 이 파일을 복사해서 .env로 만들고 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env는 .gitignore에 의해 git에 절대 커밋되지 않습니다.

# ── Discord (필수) ──────────────────────────────
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_NEWS_CHANNEL_ID=
DISCORD_ADMIN_CHANNEL_ID=
# 관리자 슬래시 명령(/status, /데이터정리 등)을 쓸 수 있는 디스코드 유저 ID.
# 콤마로 여러 명 등록 가능: 111111111,222222222
DISCORD_ADMIN_USER_IDS=

# ── Telegram (장애 알림 보조 채널, 선택) ──────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LLM 분석: 1순위 Gemini, 2순위 OpenRouter 무료, 3순위 규칙 엔진 ──
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
LLM_ANALYSIS_ENABLED=true
LLM_ANALYSIS_TIMEOUT_SECONDS=20
LLM_ANALYSIS_MAX_CHARS=9000

# ── DART / 시장 데이터 (선택) ──────────────────────
DART_API_KEY=
MARKET_INTEL_INTERVAL_SECONDS=3600
# data.krx.co.kr 계정(선택). 비워두면 비로그인 상태로 계속 동작합니다.
KRX_ID=
KRX_PW=

# ── 뉴스/블로그/유튜브/텔레그램 수집 소스 ──────────
# NEWS_KEYWORDS가 있으면 이걸 우선 사용하고, 비어 있을 때만 RSS_FEEDS를 씁니다.
NEWS_KEYWORDS=
RSS_FEEDS=
BLOG_FEEDS=
BLOG_SEARCH_QUERIES=
BLOG_SEARCH_MAX_RESULTS=10
YOUTUBE_CHANNEL_IDS=
YOUTUBE_SEARCH_QUERIES=
YOUTUBE_SEARCH_MAX_RESULTS=10
YOUTUBE_SEARCH_INTERVAL_SECONDS=60
TELEGRAM_SOURCE_CHANNELS=
TELEGRAM_SEARCH_QUERIES=
TELEGRAM_SEARCH_MAX_RESULTS=10
SOURCE_SEARCH_INTERVAL_SECONDS=60

# ── 수집/전송 주기 및 임계값 ─────────────────────
FETCH_INTERVAL_SECONDS=60
NEWS_ANALYSIS_WORKERS=6
NEWS_LOOKBACK_HOURS=24
STARTUP_SEND_LIMIT=8
MAX_NEW_PER_CYCLE=8
MAX_SENT_PER_HOUR=60
NEWS_SEND_MIN_SCORE=40
MEDIUM_NEWS_SCORE=40
STRONG_NEWS_SCORE=70

# ── 시간대 / 로그 / 상태 ─────────────────────────
TZ=UTC
NEWS_US_TIMEZONE=America/New_York
NEWS_KR_TIMEZONE=Asia/Seoul
HEALTH_STALE_THRESHOLD_SECONDS=1800
LOG_LEVEL=INFO

# ── 로컬 실행용 경로 (Render 배포 시 render.yaml 값이 우선 적용됨) ──
DB_PATH=./data/stock_news_bot.sqlite3
LOG_DIR=./logs
